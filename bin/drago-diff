#!/usr/bin/env php
<?php declare(strict_types=1);

use Composer\InstalledVersions;

$green = "\033[32m";
$yellow = "\033[33m";
$red = "\033[31m";
$blue = "\033[34m";
$reset = "\033[0m";

const InstalledFile = '.drago-project/installed.json';

/**
 * USAGE:
 * drago-diff                    : project files whose package changed them since they were installed
 * drago-diff <file>             : what the package changed in the file (installed version -> current version)
 * drago-diff <file> --project   : the project file compared with the current package file
 * drago-diff --accept <file>    : the changes are taken over; the file is compared with the current version from now on
 * drago-diff --accept --all     : the same for all files changed by their packages
 *
 * Nothing in the project is overwritten. The package versions are fetched by `composer archive` into a temporary
 * directory, so it works also after drago-clean removed the resources from vendor/.
 */
$arguments = array_slice($argv, 1);
$accept = in_array('--accept', $arguments, true);
$all = in_array('--all', $arguments, true);
$compareProject = in_array('--project', $arguments, true);
$file = current(array_filter($arguments, fn(string $arg): bool => !str_starts_with($arg, '--'))) ?: null;
$file = $file !== null ? str_replace('\\', '/', $file) : null;

$projectRoot = (string) getcwd();
if (!is_file($projectRoot . '/vendor/autoload.php')) {
	echo "{$red}ERROR: vendor/autoload.php not found. Run composer install first.{$reset}\n";
	exit(1);
}

require $projectRoot . '/vendor/autoload.php';

$installedPath = $projectRoot . '/' . InstalledFile;
$data = is_file($installedPath) ? json_decode((string) file_get_contents($installedPath), true) : null;
$installed = is_array($data['files'] ?? null) ? $data['files'] : null;
if ($installed === null) {
	echo "{$red}ERROR: " . InstalledFile . " not found. It is written by drago-install (drago-ex/project-tools 2.1+).{$reset}\n";
	exit(1);
}


function fileHash(string $file): string
{
	return sha1(str_replace("\r\n", "\n", (string) file_get_contents($file)));
}


function currentVersion(string $package): ?string
{
	return InstalledVersions::isInstalled($package) ? InstalledVersions::getPrettyVersion($package) : null;
}


function currentReference(string $package): ?string
{
	return InstalledVersions::isInstalled($package) ? InstalledVersions::getReference($package) : null;
}


function isBranch(string $version): bool
{
	return str_starts_with($version, 'dev-') || str_ends_with($version, '-dev');
}


/**
 * Whether the installed package is the one that installed the file: the same version and, when recorded,
 * the same commit, because a branch version (dev-main) moves on under the same name.
 * @param array{package: string, version: ?string, reference?: ?string} $record
 */
function isRecordedInstall(array $record): bool
{
	return currentVersion($record['package']) === $record['version']
		&& (($record['reference'] ?? null) === null || currentReference($record['package']) === $record['reference']);
}


/** A branch version shows its commit, e.g. "dev-main (a57c5d7)". */
function versionLabel(?string $version, ?string $reference): string
{
	return (string) $version
		. ($version !== null && $reference !== null && isBranch($version) ? ' (' . substr($reference, 0, 7) . ')' : '');
}


function deleteDir(string $dir): void
{
	if (!is_dir($dir) || is_link($dir)) {
		return;
	}

	$iterator = new RecursiveIteratorIterator(
		new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS),
		RecursiveIteratorIterator::CHILD_FIRST,
	);
	foreach ($iterator as $item) {
		$item->isDir() && !$item->isLink() ? rmdir($item->getPathname()) : unlink($item->getPathname());
	}

	rmdir($dir);
}


/** Directory with the package files of a version: vendor/ when it is the installed one and complete, otherwise an archive. */
function packageFiles(string $package, string $version, string $source): ?string
{
	if ($version === currentVersion($package)) {
		$path = InstalledVersions::getInstallPath($package);
		if ($path !== null && file_exists("$path/$source")) {
			return $path;
		}
	}

	static $cache = [];
	if (array_key_exists("$package@$version", $cache)) {
		return $cache["$package@$version"];
	}

	// A branch version (dev-main) changes over time, so its archive is fetched again on each run.
	$dir = sys_get_temp_dir() . '/drago-diff/' . str_replace('/', '-', $package) . '-' . preg_replace('~[^\w.-]~', '_', $version);
	if (isBranch($version)) {
		deleteDir($dir);
	}
	if (!is_dir($dir)) {
		@mkdir($dir, 0o777, true); // @ directory may already exist
		// Run outside the project: inside it, Composer does not find resource packages of other versions.
		$command = sprintf(
			'composer archive %s %s --format=tar --dir=. --file=package --no-interaction',
			escapeshellarg($package),
			escapeshellarg($version),
		);
		$process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, $dir);
		$output = is_resource($process) ? stream_get_contents($pipes[1]) . stream_get_contents($pipes[2]) : '';
		$code = is_resource($process) ? proc_close($process) : 1;
		try {
			if ($code !== 0 || !is_file("$dir/package.tar")) {
				throw new RuntimeException((string) $output);
			}
			(new PharData("$dir/package.tar"))->extractTo("$dir/files", null, true);
		} catch (Throwable $e) {
			echo "{$GLOBALS['yellow']}WARN Cannot fetch $package $version: " . trim($e->getMessage()) . "{$GLOBALS['reset']}\n";
			return $cache["$package@$version"] = null;
		}
	}

	return $cache["$package@$version"] = is_dir("$dir/files") ? "$dir/files" : null;
}


/**
 * @param array{package: string, version: ?string, reference?: ?string, source: string, hash: string} $record
 * @return array{upstream: string, local: string, current: ?string, reference: ?string}
 */
function fileStatus(string $projectRoot, string $path, array $record): array
{
	$local = !is_file("$projectRoot/$path") ? 'deleted' : (fileHash("$projectRoot/$path") === $record['hash'] ? 'unchanged' : 'modified');
	$current = currentVersion($record['package']);
	$reference = currentReference($record['package']);
	if ($current === null) {
		return ['upstream' => 'package removed', 'local' => $local, 'current' => null, 'reference' => null];
	}
	if (isRecordedInstall($record)) {
		return ['upstream' => 'unchanged', 'local' => $local, 'current' => $current, 'reference' => $reference];
	}

	$dir = packageFiles($record['package'], $current, $record['source']);
	if ($dir === null) {
		return ['upstream' => 'unknown', 'local' => $local, 'current' => $current, 'reference' => $reference];
	}

	$upstream = !is_file("$dir/{$record['source']}")
		? 'removed'
		: (fileHash("$dir/{$record['source']}") === $record['hash'] ? 'unchanged' : 'changed');
	return ['upstream' => $upstream, 'local' => $local, 'current' => $current, 'reference' => $reference];
}


/**
 * Files that a replace-once package added after it was installed: from then on its replace section is skipped
 * (skip-replace in the root composer.json), so drago-install does not copy them. Sections skipped on purpose
 * (skip, or skip-replace of a package without replace-once) are not reported; copy installs new files itself.
 * @return list<array{package: string, version: string, source: string, destination: string}>
 */
function newReplaceOnceFiles(string $projectRoot, array $installed): array
{
	$root = json_decode((string) @file_get_contents("$projectRoot/composer.json"), true); // @ the file may be missing
	$found = [];
	foreach ($root['extra']['drago-tools']['packages'] ?? [] as $package => $options) {
		$version = currentVersion((string) $package);
		if (($options['skip-replace'] ?? false) !== true || ($options['skip'] ?? false) === true || $version === null) {
			continue;
		}

		$composer = json_decode((string) @file_get_contents(InstalledVersions::getInstallPath($package) . '/composer.json'), true); // @ the file may be missing
		$install = $composer['extra']['drago-tools']['install'] ?? [];
		if (($install['replace-once'] ?? false) !== true) {
			continue;
		}

		foreach ($install['replace'] ?? [] as $sourceRule => $destinationRule) {
			$sourceRule = trim((string) $sourceRule, '/');
			$dir = packageFiles($package, $version, $sourceRule);
			if ($dir === null || !file_exists("$dir/$sourceRule")) {
				continue;
			}

			// The same mapping as drago-install: a directory keeps its tree, a file goes into a destination without an extension.
			$files = [];
			if (is_file("$dir/$sourceRule")) {
				$destination = $destinationRule === '' ? basename($sourceRule) : rtrim((string) $destinationRule, '/');
				$files[$sourceRule] = pathinfo($destination, PATHINFO_EXTENSION)
					? $destination
					: $destination . '/' . basename($sourceRule);
			} else {
				$base = $destinationRule === '' ? basename($sourceRule) : rtrim((string) $destinationRule, '/');
				$iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator(
					"$dir/$sourceRule",
					FilesystemIterator::SKIP_DOTS,
				));
				foreach ($iterator as $item) {
					if ($item->isFile()) {
						$sub = str_replace('\\', '/', substr($item->getPathname(), strlen("$dir/$sourceRule") + 1));
						$files["$sourceRule/$sub"] = "$base/$sub";
					}
				}
			}

			foreach ($files as $source => $destination) {
				if (!isset($installed[$destination]) && !file_exists("$projectRoot/$destination")) {
					$found[] = ['package' => $package, 'version' => $version, 'source' => $source, 'destination' => $destination];
				}
			}
		}
	}

	return $found;
}


function showDiff(string $old, string $new, string $oldLabel, string $newLabel): void
{
	$command = sprintf(
		'git -c core.autocrlf=false -c core.safecrlf=false diff --no-index --no-color --ignore-cr-at-eol %s %s',
		escapeshellarg($old),
		escapeshellarg($new),
	);
	// git diff exits with 0 without differences, 1 with them, anything else is an error (e.g. git is missing)
	exec($command . ' 2>&1', $output, $code);
	if ($code > 1) {
		echo "{$GLOBALS['red']}ERROR: git diff failed: " . implode("\n", $output) . "{$GLOBALS['reset']}\n";
		exit(1);
	}

	if ($output === []) {
		echo "No differences.\n";
		return;
	}

	// git shows the temporary paths; the labels say what is compared.
	echo "--- $oldLabel\n+++ $newLabel\n";
	foreach ($output as $line) {
		if (!preg_match('~^(diff --git|index |--- |\+\+\+ )~', $line)) {
			echo $line, "\n";
		}
	}
}


// One file: show the change.
if ($file !== null && !$accept) {
	$record = $installed[$file] ?? null;
	if ($record === null) {
		echo "{$red}ERROR: $file is not recorded in " . InstalledFile . ".{$reset}\n";
		exit(1);
	}

	$current = currentVersion($record['package']) ?? $record['version'];
	$currentLabel = $record['package'] . ' ' . versionLabel($current, currentReference($record['package']));
	$recordedLabel = $record['package'] . ' ' . versionLabel($record['version'], $record['reference'] ?? null);
	$new = packageFiles($record['package'], (string) $current, $record['source']);
	if ($new === null || !is_file("$new/{$record['source']}")) {
		echo "{$red}ERROR: {$record['source']} is not in {$record['package']} $current.{$reset}\n";
		exit(1);
	}

	// composer archive fetches only the newest commit of a branch, so a recorded older commit cannot be fetched;
	// the project file stands for it when it was not edited since the install.
	$oldFetchable = $record['version'] !== null && (!isBranch($record['version']) || isRecordedInstall($record));
	if ($compareProject || !$oldFetchable) {
		if (!is_file("$projectRoot/$file")) {
			echo "{$red}ERROR: $file was deleted in the project"
				. ($compareProject ? '' : " and $recordedLabel cannot be fetched (an older commit of a branch)")
				. ".{$reset}\n";
			exit(1);
		}

		if (!$compareProject) {
			echo fileHash("$projectRoot/$file") === $record['hash']
				? "$recordedLabel cannot be fetched (an older commit of a branch); the project file is unchanged since the install, so it is compared instead.\n"
				: "{$yellow}WARN $recordedLabel cannot be fetched (an older commit of a branch); the project file is compared instead and it was edited, so the diff shows the project's own changes too.{$reset}\n";
		}

		showDiff("$projectRoot/$file", "$new/{$record['source']}", "$file (project)", $currentLabel);
		exit(0);
	}

	$old = packageFiles($record['package'], $record['version'], $record['source']);
	if ($old === null || !is_file("$old/{$record['source']}")) {
		echo "{$red}ERROR: Cannot fetch {$record['package']} {$record['version']}.{$reset}\n";
		exit(1);
	}

	showDiff("$old/{$record['source']}", "$new/{$record['source']}", $recordedLabel, $currentLabel);
	exit(0);
}


// Status of all files, or accepting the changes.
$changed = [];
foreach ($installed as $path => $record) {
	if ($accept && !$all && $path !== $file) {
		continue;
	}

	$status = fileStatus($projectRoot, $path, $record);
	if ($status['upstream'] !== 'unchanged') {
		$changed[$path] = $status + ['record' => $record];
	}
}

if ($accept) {
	if (!$all && $file === null) {
		echo "{$red}ERROR: Pass a file or --all to --accept.{$reset}\n";
		exit(1);
	}

	foreach ($changed as $path => $status) {
		$record = $status['record'];
		$dir = $status['current'] !== null ? packageFiles($record['package'], $status['current'], $record['source']) : null;
		if ($dir === null || !is_file("$dir/{$record['source']}")) {
			unset($installed[$path]);
			echo "{$yellow}REMOVED from the record: $path{$reset}\n";
			continue;
		}

		$installed[$path] = [
			'version' => $status['current'],
			'reference' => $status['reference'],
			'hash' => fileHash("$dir/{$record['source']}"),
		]
			+ $record;
		echo "{$green}ACCEPTED: $path ({$record['package']} " . versionLabel($status['current'], $status['reference']) . "){$reset}\n";
	}

	ksort($installed);
	file_put_contents(
		$installedPath,
		json_encode(['files' => $installed], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n",
	);
	if ($changed === []) {
		echo "Nothing to accept.\n";
	}
	exit(0);
}

$colors = ['changed' => $yellow, 'removed' => $red, 'package removed' => $red, 'unknown' => $red];
$grouped = [];
foreach ($changed as $path => $status) {
	$grouped[$status['record']['package']][$path] = $status;
}

foreach ($grouped as $package => $files) {
	$first = current($files);
	echo "{$blue}$package{$reset} " . versionLabel($first['record']['version'], $first['record']['reference'] ?? null) . ' -> '
		. ($first['current'] !== null ? versionLabel($first['current'], $first['reference']) : '(removed)') . "\n";
	foreach ($files as $path => $status) {
		$hint = match (true) {
			$status['upstream'] === 'changed' && $status['local'] === 'unchanged'
				=> 'not edited in the project, the new version can be taken as it is',
			$status['upstream'] === 'changed' => 'edited in the project, merge by hand',
			default => '',
		};
		printf(
			"  %s%-15s%s %s%s\n",
			$colors[$status['upstream']] ?? '',
			$status['upstream'],
			$reset,
			$path,
			$hint !== '' ? "  ($hint)" : '',
		);
	}
}

$newFiles = newReplaceOnceFiles($projectRoot, $installed);
if ($newFiles !== []) {
	echo ($changed !== [] ? "\n" : '') . "New files of replace-once packages, not installed (copy them by hand if you want them):\n";
	foreach ($newFiles as $new) {
		printf(
			"  %snew%s             %s  (%s %s: %s)\n",
			$yellow,
			$reset,
			$new['destination'],
			$new['package'],
			$new['version'],
			$new['source'],
		);
	}
}

$count = count($installed);
if ($changed === [] && $newFiles === []) {
	echo "{$green}OK All $count recorded files are up to date with their packages.{$reset}\n";
} else {
	echo "\n" . count($changed) . " of $count recorded files changed in their packages, " . count($newFiles) . " new files not installed.\n"
		. ($changed !== [] ? "Show a change: drago-diff <file>; when taken over: drago-diff --accept <file>\n" : '');
}

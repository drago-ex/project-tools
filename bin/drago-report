#!/usr/bin/env php
<?php declare(strict_types=1);

$green = "\033[32m";
$yellow = "\033[33m";
$red = "\033[31m";
$blue = "\033[34m";
$magenta = "\033[35m";
$reset = "\033[0m";

/** Reports of the tools in the order they usually run when a project is set up. */
const ReportDir = '.drago-project';
const Tools = ['install', 'migration', 'commands'];
const LegacyLogFile = 'drago-install.json';

/**
 * USAGE:
 * drago-report                   : the last run of drago-install, migrations and package commands, grouped by package
 * drago-report --tool=migration  : only install|migration|commands
 * drago-report --package=name    : only entries of packages containing "name"
 * drago-report --action=skipped  : only entries with this action (e.g. copied, executed, generated, error)
 */
$tool = null;
$package = null;
$action = null;
foreach (array_slice($argv, 1) as $arg) {
	if (str_starts_with($arg, '--tool=')) {
		$tool = substr($arg, 7);
	} elseif (str_starts_with($arg, '--package=')) {
		$package = substr($arg, 10);
	} elseif (str_starts_with($arg, '--action=')) {
		$action = substr($arg, 9);
	}
}

if ($tool !== null && !in_array($tool, Tools, true)) {
	echo "{$red}ERROR: Unknown tool '$tool', use one of: " . implode(', ', Tools) . ".{$reset}\n";
	exit(1);
}


/**
 * The report of a tool; drago-install --dev writes into .dev-resource/ of the package being developed,
 * and drago-install before .drago-project/ existed wrote drago-install.json.
 */
function loadReport(string $root, string $tool): ?array
{
	$paths = [
		"$root/" . ReportDir . "/$tool.json",
		"$root/.dev-resource/" . ReportDir . "/$tool.json",
	];
	if ($tool === 'install') {
		$paths[] = "$root/" . LegacyLogFile;
		$paths[] = "$root/.dev-resource/" . LegacyLogFile;
	}

	foreach ($paths as $path) {
		if (!is_file($path)) {
			continue;
		}

		$data = json_decode((string) file_get_contents($path), true);
		if (!is_array($data) || !is_array($data['entries'] ?? null)) {
			echo "{$GLOBALS['red']}ERROR: $path is not valid.{$GLOBALS['reset']}\n";
			return null;
		}

		return $data + ['tool' => $tool, 'command' => basename($path), 'result' => null, 'stats' => []];
	}

	return null;
}


$colors = [
	'copied' => $green, 'replaced' => $green, 'executed' => $green, 'recorded' => $green, 'generated' => $green,
	'skipped' => $yellow, 'planned' => $blue,
	'error' => $red, 'failed' => $red, 'conflict' => $red,
];

$found = false;
foreach ($tool !== null ? [$tool] : Tools as $name) {
	$report = loadReport((string) getcwd(), $name);
	if ($report === null) {
		continue;
	}

	$found = true;
	$result = match ($report['result']) {
		'ok' => " {$green}ok{$reset}",
		'error' => " {$red}error{$reset}",
		default => '',
	};
	echo "{$magenta}== {$name}{$reset}: {$report['command']}, {$report['date']}{$result}\n";
	if (isset($report['message'])) {
		echo "{$red}{$report['message']}{$reset}\n";
	}

	$grouped = [];
	foreach ($report['entries'] as $entry) {
		if ($package !== null && !str_contains($entry['package'], $package)) {
			continue;
		}

		if ($action !== null && $entry['action'] !== $action) {
			continue;
		}

		$grouped[$entry['package']][] = $entry;
	}

	foreach ($grouped as $packageName => $entries) {
		$version = $entries[0]['version'] ?? null;
		echo "{$blue}{$packageName}{$reset}" . ($version !== null ? " ($version)" : '') . "\n";
		foreach ($entries as $entry) {
			$target = ($entry['destination'] ?? '') !== '' ? $entry['destination'] : ($entry['file'] ?? $entry['source'] ?? '');
			printf(
				"  %s%-9s%s %s%s%s\n",
				$colors[$entry['action']] ?? '',
				$entry['action'],
				$reset,
				$target,
				($entry['section'] ?? null) === 'replace' ? " {$magenta}[replace]{$reset}" : '',
				isset($entry['message'])
					? ' ' . (in_array($entry['action'], ['error', 'failed', 'conflict'], true) ? $red : '') . $entry['message'] . $reset
					: '',
			);
		}
	}

	$stats = [];
	foreach ($report['stats'] as $key => $count) {
		$stats[] = "$count $key";
	}
	echo ($stats !== [] ? implode(', ', $stats) : 'no entries') . "\n\n";
}

if (!$found) {
	$hint = match ($tool) {
		'install' => 'Run drago-install first.',
		'migration' => 'Run migration db:migrate --packages first.',
		'commands' => 'Run drago-commands first.',
		default => 'Run drago-install, migration db:migrate --packages or drago-commands first.',
	};
	echo "{$red}ERROR: No report found in " . ReportDir . "/. $hint{$reset}\n";
	exit(1);
}
